
SYSTEM_PROMPT_FILE=used-prompt/system-prompt/system-prompt.md
CONTENT_RULE_FILE_PATH=used-prompt/content-rules

# LLM Provider: "groq" or "gemini"
LLM_PROVIDER=gemini
TEMPERATURE=0.7

# Groq credentials
GROQ_API_KEY=gsk_your_key
GROQ_MODEL=llama-3.3-70b-versatile
#GROQ_MODEL=llama-3.1-8b-instant

# Gemini credentials
GEMINI_API_KEY=your_gemini_key
GEMINI_MODEL=gemini-flash-latest

# Agent Behaviour
AGENT_MAX_ITERATIONS=12
SEARCH_MAX_RESULTS=3
ARTICLE_TRUNCATE_LIMIT = 4000

# Logging
LOG_FILE=logs/publisher-ai.log
LOG_CONSOLE_LEVEL=INFO
LOG_FILE_LEVEL=DEBUG
LOG_CONSOLE_FORMAT=[%(asctime)s] | [%(levelname)s] | [%(name)s] | [%(filename)s:%(lineno)d] | %(message)s
LOG_DATE_FORMAT=%Y-%m-%d %H:%M:%S